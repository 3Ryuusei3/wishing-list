# Pulled automatically by `neon deploy` / `neon env pull` into .env.local
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Secret used by the same-origin auth proxy (/api/auth) to sign the session cookie.
# Generate with: openssl rand -base64 32   (not provided by Neon; set it yourself)
NEON_AUTH_COOKIE_SECRET=
